@model CreateAppointmentVM
@{
    ViewData["Title"] = "Book Appointment";
}

<style>
    .page-head {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        margin: 1.4rem 0 1rem;
    }

    .btn-back {
        border: 1.5px solid #e2e8f0;
        color: var(--navy);
        border-radius: 10px;
        font-weight: 600;
        background: #fff;
    }

        .btn-back:hover {
            border-color: var(--teal);
            color: var(--teal-dark);
        }

    .panel-card {
        background: #fff;
        border: 1px solid #eef2f7;
        border-radius: 20px;
        box-shadow: 0 18px 40px rgba(15, 42, 67, .08);
        padding: 1.6rem;
        margin-bottom: 1.4rem;
    }

    .panel-title {
        color: var(--navy);
        font-weight: 800;
        font-size: 1.15rem;
        display: flex;
        align-items: center;
        gap: .55rem;
        margin-bottom: 1rem;
    }

        .panel-title i {
            color: var(--teal);
        }

    .form-label {
        font-weight: 600;
        color: var(--navy);
        font-size: .92rem;
    }

    .input-group-text {
        background: #f0fdfa;
        color: var(--teal-dark);
        border-color: #e2e8f0;
    }

    .form-control, .form-select {
        border-color: #e2e8f0;
        border-radius: 10px;
        padding: .6rem .9rem;
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--teal);
            box-shadow: 0 0 0 .2rem rgba(13, 148, 136, .15);
        }

    .field-validation-error {
        color: #dc2626;
        font-size: .85rem;
    }

    .form-hint {
        color: var(--muted);
        font-size: .82rem;
        margin-top: .35rem;
    }

        .form-hint.error {
            color: #dc2626;
            font-weight: 600;
        }

    /* Doctor header */
    .doc-head {
        display: flex;
        gap: 1.2rem;
        align-items: center;
        flex-wrap: wrap;
    }

    .doc-avatar {
        width: 84px;
        height: 84px;
        border-radius: 18px;
        flex: 0 0 auto;
        background: linear-gradient(135deg, #14b8a6, #0f766e);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.9rem;
        font-weight: 800;
        letter-spacing: 1px;
        box-shadow: 0 10px 22px rgba(13, 148, 136, .30);
    }

    .doc-name {
        color: var(--navy);
        font-weight: 800;
        font-size: 1.6rem;
        margin: 0;
    }

    .doc-specialty {
        color: var(--teal-dark);
        font-weight: 700;
        margin: .15rem 0 .5rem;
    }

    .doc-meta {
        display: flex;
        gap: 1.1rem;
        flex-wrap: wrap;
        color: var(--muted);
        font-size: .92rem;
    }

        .doc-meta i {
            color: var(--teal);
            margin-right: .3rem;
        }

    /* Weekly schedule table */
    .sched-table {
        width: 100%;
        border-collapse: collapse;
    }

        .sched-table th {
            text-align: left;
            color: var(--muted);
            font-size: .74rem;
            letter-spacing: .6px;
            text-transform: uppercase;
            padding: .5rem .4rem;
            border-bottom: 1px solid #e2e8f0;
        }

        .sched-table td {
            padding: .65rem .4rem;
            border-bottom: 1px solid #f1f5f9;
            color: var(--navy);
        }

        .sched-table tr:last-child td {
            border-bottom: none;
        }

    .sched-day {
        font-weight: 700;
    }

    .sched-note {
        color: var(--muted);
        font-size: .86rem;
        margin-top: .9rem;
        line-height: 1.6;
    }

    /* Booking panel */
    @@media (min-width: 992px) {
        .booking-panel {
            position: sticky;
            top: 96px;
        }
    }

    .times-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: .5rem;
    }

    .time-chip {
        border: 1.5px solid #99e5da;
        background: #fff;
        color: var(--navy);
        border-radius: 10px;
        padding: .5rem .2rem;
        font-weight: 600;
        font-size: .9rem;
        cursor: pointer;
        transition: all .15s ease;
    }

        .time-chip:hover {
            border-color: var(--teal);
            background: #f0fdfa;
        }

        .time-chip.active {
            background: linear-gradient(120deg, #0d9488, #0f766e);
            color: #fff;
            border-color: transparent;
        }

    .times-empty {
        color: var(--muted);
        font-size: .9rem;
        border: 1px dashed #cbd5e1;
        border-radius: 10px;
        padding: .8rem;
        text-align: center;
    }

    .summary-box {
        background: #f0fdfa;
        border: 1px solid #ccfbf1;
        border-radius: 14px;
        padding: 1rem 1.1rem;
        margin-top: 1.1rem;
    }

        .summary-box .sum-row {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
            padding: .3rem 0;
        }

        .summary-box .sum-label {
            color: var(--muted);
            font-size: .92rem;
        }

        .summary-box .sum-value {
            color: var(--navy);
            font-weight: 700;
            text-align: right;
        }

    .btn-book {
        width: 100%;
        background: linear-gradient(120deg, #0d9488, #0f766e);
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: .75rem 1.6rem;
        font-weight: 700;
        margin-top: 1.1rem;
        box-shadow: 0 6px 14px rgba(13, 148, 136, .28);
    }

        .btn-book:hover {
            color: #fff;
            transform: translateY(-1px);
        }

    .pending-note {
        color: var(--muted);
        font-size: .85rem;
        text-align: center;
        margin-top: .7rem;
    }
</style>

<div class="page-head">
    <a class="btn btn-back" asp-action="Index">
        <i class="bi bi-arrow-left"></i> Back to Appointments
    </a>
</div>

<form asp-action="Create" method="post" id="bookingForm">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row g-4">
        @* ================= Left: doctor profile ================= *@
        <div class="col-lg-8">
            @* Doctor picker — changing it reloads the whole profile + times *@
            <div class="panel-card">
                <label class="form-label" for="DoctorId">Doctor</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    <select asp-for="DoctorId" asp-items="ViewBag.Doctors" class="form-select">
                        <option value="">-- Select doctor --</option>
                    </select>
                </div>
                <span asp-validation-for="DoctorId"></span>
            </div>

            @* Doctor header *@
            <div class="panel-card">
                <div class="doc-head">
                    <div class="doc-avatar" id="docInitials">?</div>
                    <div>
                        <h3 class="doc-name" id="docName">Select a doctor</h3>
                        <div class="doc-specialty" id="docSpecialty">His profile, schedule and free times will appear here</div>
                        <div class="doc-meta">
                            <span><i class="bi bi-clock-history"></i><span id="docDuration">Consultation duration: —</span></span>
                            <span><i class="bi bi-calendar-week"></i><span id="docDays">Working days: —</span></span>
                        </div>
                    </div>
                </div>
            </div>

            @* About *@
            <div class="panel-card">
                <div class="panel-title"><i class="bi bi-info-circle"></i> About</div>
                <p class="mb-0" style="color: var(--navy); line-height: 1.7;" id="docBio">Pick a doctor above to read his bio.</p>
            </div>

            @* Weekly schedule *@
            <div class="panel-card">
                <div class="panel-title"><i class="bi bi-calendar3"></i> Weekly schedule — AvailabilitySlots</div>
                <table class="sched-table">
                    <thead>
                        <tr><th>Day</th><th>Working hours</th><th>Slot length</th></tr>
                    </thead>
                    <tbody id="scheduleBody">
                        <tr><td colspan="3" style="color: var(--muted);">No doctor selected yet.</td></tr>
                    </tbody>
                </table>
                <div class="sched-note">
                    These rows are the doctor's AvailabilitySlot records. The booking panel
                    generates the bookable times from the slot that matches the chosen date's day of week.
                </div>
            </div>
        </div>

        @* ================= Right: booking panel ================= *@
        <div class="col-lg-4">
            <div class="panel-card booking-panel">
                <div class="panel-title"><i class="bi bi-calendar-plus"></i> Book an appointment</div>

                <div class="mb-3">
                    <label class="form-label" for="AppointmentDate">Choose a date <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-calendar3"></i></span>
                        <input asp-for="AppointmentDate" type="date" class="form-control" />
                    </div>
                    <span asp-validation-for="AppointmentDate"></span>
                    <div class="form-hint" id="hoursNote"></div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Available times</label>
                    <div id="timesBox">
                        <div class="times-empty">Select a doctor and a date to see the free times.</div>
                    </div>
                    <input type="hidden" asp-for="StartTime"
                           data-selected="@(Model.StartTime != TimeSpan.Zero ? Model.StartTime.ToString(@"hh\:mm") : "")" />
                    <span asp-validation-for="StartTime"></span>
                    <div class="form-hint" id="timeHint">Only free times are shown — booked or passed times never appear here.</div>
                </div>

                <div class="mb-1">
                    <label class="form-label" for="Notes">Reason for visit (optional)</label>
                    <textarea asp-for="Notes" class="form-control" rows="3" maxlength="500"
                              placeholder="Briefly describe your symptoms or reason..."></textarea>
                    <span asp-validation-for="Notes"></span>
                </div>

                <div class="summary-box">
                    <div class="sum-row"><span class="sum-label">Doctor</span><span class="sum-value" id="pvDoctor">—</span></div>
                    <div class="sum-row"><span class="sum-label">Date</span><span class="sum-value" id="pvDate">—</span></div>
                    <div class="sum-row"><span class="sum-label">Time</span><span class="sum-value" id="pvTime">— pick a time —</span></div>
                </div>

                <button type="submit" class="btn btn-book">
                    <i class="bi bi-calendar-check"></i> Confirm Booking
                </button>
                <div class="pending-note">Your appointment is saved as <strong>Pending</strong> until the doctor confirms it.</div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var doctorSelect = document.getElementById('DoctorId');
        var dateInput = document.getElementById('AppointmentDate');
        var timeInput = document.getElementById('StartTime');
        var timesBox = document.getElementById('timesBox');
        var timeHint = document.getElementById('timeHint');
        var hoursNote = document.getElementById('hoursNote');
        var infoUrl = '@Url.Action("GetDoctorInfo", "Appointment")';
        var timesUrl = '@Url.Action("GetAvailableTimes", "Appointment")';
        var defaultHint = timeHint.textContent;
        var dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
        var currentSchedule = [];
        var currentDuration = 0;

        // The date picker cannot offer days in the past (the service checks again anyway).
        var now = new Date();
        var mm = String(now.getMonth() + 1).padStart(2, '0');
        var dd = String(now.getDate()).padStart(2, '0');
        dateInput.min = now.getFullYear() + '-' + mm + '-' + dd;
        timeInput.value = ''; // a fresh form has no time until a chip is picked

        function to12h(value) {
            var parts = value.split(':');
            var h = parseInt(parts[0], 10);
            var suffix = h >= 12 ? 'PM' : 'AM';
            var h12 = h % 12;
            if (h12 === 0) h12 = 12;
            return h12 + ':' + parts[1] + ' ' + suffix;
        }

        function initialsOf(name) {
            var parts = name.trim().split(/\s+/);
            if (parts.length >= 2) return (parts[0].charAt(0) + parts[1].charAt(0)).toUpperCase();
            return name.charAt(0).toUpperCase();
        }

        // ---------- Doctor profile (header / About / schedule) ----------
        function loadDoctorInfo() {
            var doctorId = doctorSelect.value;
            if (!doctorId) {
                document.getElementById('docInitials').textContent = '?';
                document.getElementById('docName').textContent = 'Select a doctor';
                document.getElementById('docSpecialty').textContent = 'His profile, schedule and free times will appear here';
                document.getElementById('docDuration').textContent = 'Consultation duration: —';
                document.getElementById('docDays').textContent = 'Working days: —';
                document.getElementById('docBio').textContent = 'Pick a doctor above to read his bio.';
                document.getElementById('scheduleBody').innerHTML =
                    '<tr><td colspan="3" style="color: var(--muted);">No doctor selected yet.</td></tr>';
                currentSchedule = [];
                currentDuration = 0;
                updateHoursNote();
                loadTimes();
                syncSummary();
                return;
            }

            fetch(infoUrl + '?doctorId=' + encodeURIComponent(doctorId))
                .then(function (response) { return response.json(); })
                .then(function (info) {
                    document.getElementById('docInitials').textContent = initialsOf(info.doctorName);
                    document.getElementById('docName').textContent = info.doctorName;
                    document.getElementById('docSpecialty').textContent = info.specialtyName || 'General';
                    document.getElementById('docDuration').textContent = 'Consultation duration: ' + info.consultationDurationMinutes + ' min';
                    document.getElementById('docBio').textContent = info.bio ? info.bio : 'No bio provided for this doctor yet.';
                    currentSchedule = info.schedule || [];
                    currentDuration = info.consultationDurationMinutes;

                    var days = [];
                    currentSchedule.forEach(function (row) { if (days.indexOf(row.day) === -1) days.push(row.day); });
                    document.getElementById('docDays').textContent = 'Working days: ' + (days.length ? days.join(', ') : '—');

                    var tbody = document.getElementById('scheduleBody');
                    if (!currentSchedule.length) {
                        tbody.innerHTML = '<tr><td colspan="3" style="color: var(--muted);">This doctor has no weekly schedule yet.</td></tr>';
                    } else {
                        tbody.innerHTML = '';
                        currentSchedule.forEach(function (row) {
                            var tr = document.createElement('tr');
                            tr.innerHTML = '<td class="sched-day"></td><td></td><td></td>';
                            tr.children[0].textContent = row.day;
                            tr.children[1].textContent = to12h(row.startTime) + ' – ' + to12h(row.endTime);
                            tr.children[2].textContent = 'every ' + currentDuration + ' min';
                            tbody.appendChild(tr);
                        });
                    }

                    updateHoursNote();
                    loadTimes();
                    syncSummary();
                })
                .catch(function () {
                    document.getElementById('docName').textContent = 'Could not load this doctor';
                    currentSchedule = [];
                    updateHoursNote();
                    loadTimes();
                });
        }

        // ---------- Working-hours note under the date ----------
        function updateHoursNote() {
            if (!doctorSelect.value || !dateInput.value || !currentSchedule.length) {
                hoursNote.textContent = '';
                return;
            }
            var dayName = dayNames[new Date(dateInput.value + 'T00:00:00').getDay()];
            var rows = currentSchedule.filter(function (r) { return r.day === dayName; });
            if (!rows.length) {
                hoursNote.textContent = 'The doctor does not work on ' + dayName + 's — pick another date.';
                return;
            }
            var ranges = rows.map(function (r) { return to12h(r.startTime) + ' – ' + to12h(r.endTime); });
            hoursNote.textContent = 'Working hours on ' + dayName + ': ' + ranges.join(', ') +
                ' · only free times are shown — booked or passed times are hidden.';
        }

        // ---------- Free-times chips ----------
        function loadTimes() {
            timeInput.value = '';
            timeHint.textContent = defaultHint;
            timeHint.classList.remove('error');

            var doctorId = doctorSelect.value;
            var date = dateInput.value;
            if (!doctorId || !date) {
                timesBox.innerHTML = '<div class="times-empty">Select a doctor and a date to see the free times.</div>';
                syncSummary();
                return;
            }

            timesBox.innerHTML = '<div class="times-empty">Loading available times...</div>';
            fetch(timesUrl + '?doctorId=' + encodeURIComponent(doctorId) + '&date=' + encodeURIComponent(date))
                .then(function (response) { return response.json(); })
                .then(function (times) {
                    if (!times.length) {
                        timesBox.innerHTML = '<div class="times-empty">No free times on this day — try another date.</div>';
                    } else {
                        timesBox.innerHTML = '';
                        var grid = document.createElement('div');
                        grid.className = 'times-grid';
                        times.forEach(function (t) {
                            var chip = document.createElement('button');
                            chip.type = 'button';
                            chip.className = 'time-chip';
                            chip.textContent = to12h(t);
                            chip.setAttribute('data-time', t);
                            chip.addEventListener('click', function () { selectTime(t, chip); });
                            grid.appendChild(chip);
                        });
                        timesBox.appendChild(grid);

                        // After a failed booking attempt, re-pick the time the patient had chosen.
                        var preselected = timeInput.getAttribute('data-selected');
                        if (preselected && times.indexOf(preselected) !== -1) {
                            var match = grid.querySelector('[data-time="' + preselected + '"]');
                            if (match) selectTime(preselected, match);
                        }
                    }
                    syncSummary();
                })
                .catch(function () {
                    timesBox.innerHTML = '<div class="times-empty">Could not load the times — change the date or doctor to try again.</div>';
                    syncSummary();
                });
        }

        function selectTime(value, chip) {
            timeInput.value = value;
            var chips = timesBox.querySelectorAll('.time-chip');
            chips.forEach(function (c) { c.classList.remove('active'); });
            chip.classList.add('active');
            timeHint.textContent = defaultHint;
            timeHint.classList.remove('error');
            syncSummary();
        }

        // ---------- Summary box ----------
        function syncSummary() {
            var docText = doctorSelect.options[doctorSelect.selectedIndex].text;
            document.getElementById('pvDoctor').textContent = doctorSelect.value ? docText : '—';
            if (dateInput.value) {
                document.getElementById('pvDate').textContent =
                    new Date(dateInput.value + 'T00:00:00').toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'short', year: 'numeric' });
            } else {
                document.getElementById('pvDate').textContent = '—';
            }
            document.getElementById('pvTime').textContent = timeInput.value ? to12h(timeInput.value) : '— pick a time —';
        }

        // ---------- Guards + events ----------
        document.getElementById('bookingForm').addEventListener('submit', function (e) {
            if (doctorSelect.value && dateInput.value && !timeInput.value) {
                e.preventDefault();
                timeHint.textContent = 'Pick one of the free times first.';
                timeHint.classList.add('error');
                timesBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        });

        doctorSelect.addEventListener('change', loadDoctorInfo);
        dateInput.addEventListener('change', function () { updateHoursNote(); loadTimes(); syncSummary(); });
        loadDoctorInfo(); // fills everything when the doctor arrives pre-selected
    </script>
}

