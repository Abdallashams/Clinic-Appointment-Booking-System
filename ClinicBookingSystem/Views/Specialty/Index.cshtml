@model List<GetSpecialtyVM>
@{
    ViewData["Title"] = "Specialties";
    var count = 0;
    foreach (var s in Model) { count++; }
}

<style>
    .page-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        margin: 1.6rem 0 1.2rem;
    }

        .page-head h2 {
            color: var(--navy);
            font-weight: 800;
            margin: 0;
            display: flex;
            align-items: center;
            gap: .6rem;
        }

            .page-head h2 i {
                color: var(--teal);
            }

        .page-head p {
            color: var(--muted);
            margin: .25rem 0 0;
            font-size: .95rem;
        }

    .btn-add {
        background: linear-gradient(120deg, #0d9488, #0f766e);
        color: #fff;
        border-radius: 10px;
        padding: .55rem 1.2rem;
        font-weight: 600;
        box-shadow: 0 6px 14px rgba(13, 148, 136, .28);
    }

        .btn-add:hover {
            color: #fff;
            transform: translateY(-1px);
        }

    .table-card {
        background: #fff;
        border: 1px solid #eef2f7;
        border-radius: 20px;
        box-shadow: 0 18px 40px rgba(15, 42, 67, .08);
        padding: 1.2rem 1.4rem;
    }

    .spec-table {
        margin: 0;
    }

        .spec-table thead th {
            color: var(--muted);
            font-size: .78rem;
            letter-spacing: .6px;
            text-transform: uppercase;
            border-bottom: 2px solid #eef2f7;
            padding: .8rem .75rem;
        }

        .spec-table tbody td {
            padding: .95rem .75rem;
            vertical-align: middle;
            border-color: #f1f5f9;
            color: var(--navy);
        }

        .spec-table tbody tr:hover {
            background: #f8fafc;
        }

    .spec-name {
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: .55rem;
    }

        .spec-name i {
            color: var(--teal-dark);
            background: #f0fdfa;
            border: 1px solid #99f6e4;
            border-radius: 8px;
            padding: .3rem .4rem;
            font-size: .85rem;
        }

    .spec-desc {
        color: var(--muted);
        font-size: .92rem;
    }

    .actions-cell {
        white-space: nowrap;
    }

    .btn-act {
        border-radius: 8px;
        font-weight: 600;
        font-size: .82rem;
        padding: .35rem .8rem;
    }

    .btn-edit {
        border: 1.5px solid var(--teal);
        color: var(--teal-dark);
        background: #fff;
    }

        .btn-edit:hover {
            background: var(--teal);
            color: #fff;
        }

    .btn-details {
        border: 1.5px solid #e2e8f0;
        color: var(--navy);
        background: #fff;
    }

        .btn-details:hover {
            border-color: var(--navy);
            color: var(--navy);
        }

    .btn-delete {
        border: 1.5px solid #fecaca;
        color: #dc2626;
        background: #fff;
    }

        .btn-delete:hover {
            background: #dc2626;
            border-color: #dc2626;
            color: #fff;
        }

    .delete-form {
        display: inline;
    }

    .empty-box {
        background: #fff;
        border: 1px dashed #cbd5e1;
        border-radius: 20px;
        padding: 3rem 1.5rem;
        text-align: center;
        color: var(--muted);
    }

        .empty-box i {
            font-size: 2.6rem;
            color: var(--teal);
            display: block;
            margin-bottom: .8rem;
        }
</style>

<div class="page-head">
    <div>
        <h2><i class="bi bi-heart-pulse"></i> Specialties</h2>
        <p>@count specialty(ies) — these feed the doctor form and the home page.</p>
    </div>
    <a class="btn btn-add" asp-action="Create">
        <i class="bi bi-plus-lg"></i> Create New Specialty
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> @TempData["Error"]</div>
}

@if (count == 0)
{
    <div class="empty-box">
        <i class="bi bi-heart-pulse"></i>
        <div class="fw-semibold" style="color: var(--navy);">No specialties yet</div>
        <div>Create the first specialty to get started.</div>
    </div>
}
else
{
    <div class="table-card">
        <table class="table spec-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><span class="spec-name"><i class="bi bi-heart-pulse-fill"></i> @item.Name</span></td>
                        <td class="spec-desc">@(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)</td>
                        <td class="actions-cell text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-act btn-edit">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-act btn-details">
                                <i class="bi bi-eye"></i> Details
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="delete-form"
                                  onsubmit="return confirm('Are you sure you want to delete this specialty?');">
                                <button type="submit" class="btn btn-act btn-delete">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
