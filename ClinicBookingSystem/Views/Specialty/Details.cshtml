@model GetSpecialtyVM

@{
    ViewData["Title"] = "Specialty Details";
}

<style>
    .page-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        margin: 1.6rem 0 1.2rem;
    }

        .page-head h2 {
            color: var(--navy);
            font-weight: 800;
            margin: 0;
            display: flex;
            align-items: center;
            gap: .6rem;
        }

            .page-head h2 i {
                color: var(--teal);
            }

        .page-head p {
            color: var(--muted);
            margin: .25rem 0 0;
            font-size: .95rem;
        }

    .btn-back {
        border: 1.5px solid #e2e8f0;
        color: var(--navy);
        border-radius: 10px;
        font-weight: 600;
    }

        .btn-back:hover {
            border-color: var(--teal);
            color: var(--teal-dark);
        }

    .details-wrap {
        max-width: 760px;
        margin: 0 auto;
    }

    .details-card {
        background: #fff;
        border: 1px solid #eef2f7;
        border-radius: 20px;
        box-shadow: 0 18px 40px rgba(15, 42, 67, .08);
        padding: 1.8rem;
    }

    .spec-head {
        display: flex;
        align-items: center;
        gap: 1.1rem;
    }

    .spec-icon {
        width: 72px;
        height: 72px;
        border-radius: 20px;
        flex: 0 0 auto;
        background: linear-gradient(135deg, #0d9488, #0f766e);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.9rem;
        box-shadow: 0 10px 22px rgba(13, 148, 136, .3);
    }

    .spec-name {
        color: var(--navy);
        font-weight: 800;
        font-size: 1.5rem;
        margin: 0;
    }

    .spec-sub {
        color: var(--muted);
        font-size: .9rem;
        margin-top: .15rem;
    }

    .field-label {
        font-size: .72rem;
        letter-spacing: .6px;
        text-transform: uppercase;
        color: var(--muted);
        font-weight: 700;
        margin-bottom: .35rem;
    }

    .desc-text {
        color: var(--navy);
        font-size: .98rem;
        line-height: 1.65;
        margin: 0;
        white-space: pre-line;
    }

    .desc-empty {
        color: var(--muted);
        font-style: italic;
        margin: 0;
    }

    .btn-edit {
        border: 1.5px solid var(--teal);
        color: var(--teal-dark);
        border-radius: 10px;
        font-weight: 600;
        padding: .6rem 1.4rem;
    }

        .btn-edit:hover {
            background: var(--teal);
            color: #fff;
        }

    .btn-cancel {
        border: 1.5px solid #e2e8f0;
        color: var(--navy);
        border-radius: 10px;
        padding: .6rem 1.4rem;
        font-weight: 600;
    }

        .btn-cancel:hover {
            border-color: #cbd5e1;
            color: var(--navy);
        }
</style>

<div class="page-head">
    <div>
        <h2><i class="bi bi-heart-pulse"></i> Specialty Details</h2>
        <p>Everything about this specialty in one place.</p>
    </div>
    <a class="btn btn-back" asp-action="Index">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<div class="details-wrap">
    <div class="details-card">
        <div class="spec-head">
            <div class="spec-icon"><i class="bi bi-heart-pulse-fill"></i></div>
            <div>
                <h3 class="spec-name">@Model.Name</h3>
                <div class="spec-sub">Medical specialty · #@Model.Id</div>
            </div>
        </div>

        <hr class="my-4" />

        <div class="field-label">Description</div>
        @if (string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="desc-empty">No description provided for this specialty yet.</p>
        }
        else
        {
            <p class="desc-text">@Model.Description</p>
        }

        <hr class="my-4" />
        <div class="d-flex gap-2 justify-content-end">
            <a class="btn btn-cancel" asp-action="Index">Back to List</a>
            <a class="btn btn-edit" asp-action="Edit" asp-route-id="@Model.Id">
                <i class="bi bi-pencil"></i> Edit
            </a>
        </div>
    </div>
</div>
