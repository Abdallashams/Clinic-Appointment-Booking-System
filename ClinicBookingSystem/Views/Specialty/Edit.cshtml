@model UpdateSpecialtyVM

@{
    ViewData["Title"] = "Edit Specialty";
}

<style>
    .page-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        margin: 1.6rem 0 1.2rem;
    }

        .page-head h2 {
            color: var(--navy);
            font-weight: 800;
            margin: 0;
            display: flex;
            align-items: center;
            gap: .6rem;
        }

            .page-head h2 i {
                color: var(--teal);
            }

        .page-head p {
            color: var(--muted);
            margin: .25rem 0 0;
            font-size: .95rem;
        }

    .btn-back {
        border: 1.5px solid #e2e8f0;
        color: var(--navy);
        border-radius: 10px;
        font-weight: 600;
    }

        .btn-back:hover {
            border-color: var(--teal);
            color: var(--teal-dark);
        }

    .form-wrap {
        max-width: 760px;
        margin: 0 auto;
    }

    .form-card {
        background: #fff;
        border: 1px solid #eef2f7;
        border-radius: 20px;
        box-shadow: 0 18px 40px rgba(15, 42, 67, .08);
        padding: 1.8rem;
    }

        .form-card .form-label {
            font-weight: 600;
            color: var(--navy);
            font-size: .92rem;
        }

    .input-group-text {
        background: #f0fdfa;
        color: var(--teal-dark);
        border-color: #e2e8f0;
    }

    .form-control {
        border-color: #e2e8f0;
        border-radius: 10px;
        padding: .6rem .9rem;
    }

        .form-control:focus {
            border-color: var(--teal);
            box-shadow: 0 0 0 .2rem rgba(13, 148, 136, .15);
        }

    .field-validation-error {
        color: #dc2626;
        font-size: .85rem;
    }

    .form-hint {
        color: var(--muted);
        font-size: .82rem;
        margin-top: .35rem;
    }

    .btn-save {
        background: linear-gradient(120deg, #0d9488, #0f766e);
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: .65rem 1.6rem;
        font-weight: 600;
        box-shadow: 0 6px 14px rgba(13, 148, 136, .28);
    }

        .btn-save:hover {
            color: #fff;
            transform: translateY(-1px);
        }

    .btn-cancel {
        border: 1.5px solid #e2e8f0;
        color: var(--navy);
        border-radius: 10px;
        padding: .65rem 1.4rem;
        font-weight: 600;
    }

        .btn-cancel:hover {
            border-color: #cbd5e1;
            color: var(--navy);
        }
</style>

<div class="page-head">
    <div>
        <h2><i class="bi bi-pencil-square"></i> Edit Specialty</h2>
        <p>Editing <strong>@Model.Name</strong> — changes appear across the site right away.</p>
    </div>
    <a class="btn btn-back" asp-action="Index">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<div class="form-wrap">
    <div class="form-card">
        <form asp-action="Edit" method="post">
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-tag"></i></span>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Cardiology" />
                </div>
                <span asp-validation-for="Name"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"
                          placeholder="What this specialty covers — shown on the home page and the doctors directory (optional)"></textarea>
                <div class="form-hint">Keep it short: one or two sentences is enough.</div>
                <span asp-validation-for="Description"></span>
            </div>

            <hr class="my-4" />
            <div class="d-flex gap-2 justify-content-end">
                <a class="btn btn-cancel" asp-action="Index">Cancel</a>
                <button type="submit" class="btn btn-save">
                    <i class="bi bi-check-lg"></i> Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
