@model CreateDoctorVM

@{
    ViewData["Title"] = "Add Doctor";
}

<style>
    .page-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin: 1.6rem 0 1.2rem; }
    .page-head h2 { color: var(--navy); font-weight: 800; margin: 0; display: flex; align-items: center; gap: .6rem; }
    .page-head h2 i { color: var(--teal); }
    .page-head p { color: var(--muted); margin: .25rem 0 0; font-size: .95rem; }
    .btn-back { border: 1.5px solid #e2e8f0; color: var(--navy); border-radius: 10px; font-weight: 600; }
    .btn-back:hover { border-color: var(--teal); color: var(--teal-dark); }

    .form-card { background: #fff; border: 1px solid #eef2f7; border-radius: 20px; box-shadow: 0 18px 40px rgba(15, 42, 67, .08); padding: 1.8rem; }
    .form-card .form-label { font-weight: 600; color: var(--navy); font-size: .92rem; }
    .input-group-text { background: #f0fdfa; color: var(--teal-dark); border-color: #e2e8f0; }
    .form-control, .form-select { border-color: #e2e8f0; border-radius: 10px; padding: .6rem .9rem; }
    .form-control:focus, .form-select:focus { border-color: var(--teal); box-shadow: 0 0 0 .2rem rgba(13, 148, 136, .15); }
    .field-validation-error { color: #dc2626; font-size: .85rem; }

    .upload-box { text-align: center; }
    .avatar-preview {
        width: 132px; height: 132px; margin: 0 auto; border-radius: 50%;
        border: 2px dashed #99f6e4; background: #f0fdfa; color: var(--teal);
        display: flex; align-items: center; justify-content: center; font-size: 3rem;
        overflow: hidden; cursor: pointer; transition: border-color .2s;
    }
    .avatar-preview:hover { border-color: var(--teal); }
    .avatar-preview img { width: 100%; height: 100%; object-fit: cover; display: none; }
    .upload-hint { color: var(--muted); font-size: .82rem; margin-top: .6rem; }

    .preview-card { border: 1px solid #eef2f7; border-radius: 16px; padding: 1rem; margin-top: 1.4rem; background: #f8fafc; }
    .preview-card .pv-label { font-size: .72rem; letter-spacing: .6px; text-transform: uppercase; color: var(--muted); font-weight: 700; }
    .preview-card .pv-name { color: var(--navy); font-weight: 700; font-size: 1.05rem; margin-top: .3rem; }
    .preview-card .pv-meta { color: var(--muted); font-size: .88rem; display: flex; gap: 1rem; flex-wrap: wrap; margin-top: .2rem; }
    .preview-card .pv-meta i { color: var(--teal); }

    .btn-create {
        background: linear-gradient(120deg, #0d9488, #0f766e); color: #fff; border: none;
        border-radius: 10px; padding: .65rem 1.6rem; font-weight: 600;
        box-shadow: 0 6px 14px rgba(13, 148, 136, .28);
    }
    .btn-create:hover { color: #fff; transform: translateY(-1px); }
    .btn-cancel { border: 1.5px solid #e2e8f0; color: var(--navy); border-radius: 10px; padding: .65rem 1.4rem; font-weight: 600; }
    .btn-cancel:hover { border-color: #cbd5e1; color: var(--navy); }
</style>

<div class="page-head">
    <div>
        <h2><i class="bi bi-person-plus-fill"></i> Add New Doctor</h2>
        <p>Create a doctor profile — it will appear in the doctors directory once active.</p>
    </div>
    <a class="btn btn-back" asp-controller="Doctors" asp-action="Index">
        <i class="bi bi-arrow-left"></i> Back to Doctors
    </a>
</div>

<div class="form-card">
    <form asp-controller="Doctors" asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row g-4">
            @* ---------- Left: the form fields ---------- *@
            <div class="col-lg-8">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input asp-for="FullName" class="form-control" maxlength="100" placeholder="e.g. Dr. Sara Ahmed" />
                        </div>
                        <span asp-validation-for="FullName"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="SpecialtyId" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-heart-pulse"></i></span>
                            <select asp-for="SpecialtyId" asp-items="ViewBag.Specialties" class="form-select">
                                <option value="">-- Select specialty --</option>
                            </select>
                        </div>
                        <span asp-validation-for="SpecialtyId"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" type="email" class="form-control" placeholder="doctor@clinic.com" />
                        </div>
                        <span asp-validation-for="Email"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                            <input asp-for="PhoneNumber" type="tel" class="form-control" placeholder="01xxxxxxxxx" />
                        </div>
                        <span asp-validation-for="PhoneNumber"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ConsultationDurationMinutes" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-clock"></i></span>
                            <input asp-for="ConsultationDurationMinutes" type="number" min="5" max="120" class="form-control" />
                            <span class="input-group-text">min</span>
                        </div>
                        <span asp-validation-for="ConsultationDurationMinutes"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Bio" class="form-label"></label>
                        <textarea asp-for="Bio" class="form-control" rows="4" maxlength="500"
                                  placeholder="Short bio shown on the doctor's profile (optional)"></textarea>
                        <span asp-validation-for="Bio"></span>
                    </div>
                </div>
            </div>

            @* ---------- Right: image upload + live preview ---------- *@
            <div class="col-lg-4">
                <div class="upload-box">
                    <label asp-for="ProfileImage" class="form-label d-block"></label>
                    <label class="avatar-preview" for="ProfileImage" title="Click to upload a photo">
                        <i class="bi bi-person-fill" id="avatarIcon"></i>
                        <img id="avatarImg" alt="Doctor photo preview" />
                    </label>
                    <input asp-for="ProfileImage" type="file" accept="image/*" class="d-none" />
                    <div class="upload-hint">Click the circle to upload a photo (JPG / PNG)</div>
                    <span asp-validation-for="ProfileImage"></span>
                </div>

                <div class="preview-card">
                    <div class="pv-label">Directory preview</div>
                    <div class="pv-name" id="pvName">Doctor name</div>
                    <div class="pv-meta">
                        <span><i class="bi bi-heart-pulse"></i> <span id="pvSpec">Specialty</span></span>
                        <span><i class="bi bi-clock"></i> <span id="pvDur">30</span> min</span>
                    </div>
                </div>
            </div>
        </div>

        <hr class="my-4" />
        <div class="d-flex gap-2 justify-content-end">
            <a class="btn btn-cancel" asp-controller="Doctors" asp-action="Index">Cancel</a>
            <button type="submit" class="btn btn-create">
                <i class="bi bi-check-lg"></i> Create Doctor
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Live image preview when a photo is picked.
        document.getElementById('ProfileImage').addEventListener('change', function () {
            var file = this.files && this.files[0];
            if (!file) return;
            var img = document.getElementById('avatarImg');
            img.src = URL.createObjectURL(file);
            img.style.display = 'block';
            document.getElementById('avatarIcon').style.display = 'none';
        });

        // Live directory-card preview (name / specialty / duration).
        var nameInput = document.getElementById('FullName');
        var specSelect = document.getElementById('SpecialtyId');
        var durInput = document.getElementById('ConsultationDurationMinutes');
        nameInput.addEventListener('input', function () {
            document.getElementById('pvName').textContent = this.value.trim() || 'Doctor name';
        });
        specSelect.addEventListener('change', function () {
            var txt = this.options[this.selectedIndex].text;
            document.getElementById('pvSpec').textContent = this.value ? txt : 'Specialty';
        });
        durInput.addEventListener('input', function () {
            document.getElementById('pvDur').textContent = this.value || '30';
        });
    </script>
}
