@model ClinicBookingSystem.ModelVM.AvailabilitySlot.GetAvailabilitySlotVM

@{
    ViewData["Title"] = "Slot Details";
}

<div class="container mt-4">
    <h2>Availability Slot Details</h2>

    <div>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">Doctor Name:</dt>
            <dd class="col-sm-9">@Model.DoctorName</dd>

            <dt class="col-sm-3">Day of Week:</dt>
            <dd class="col-sm-9">@Model.DayOfWeek</dd>

            <dt class="col-sm-3">Start Time:</dt>
            <dd class="col-sm-9">@Model.StartTime</dd>

            <dt class="col-sm-3">End Time:</dt>
            <dd class="col-sm-9">@Model.EndTime</dd>

            <dt class="col-sm-3">Status:</dt>
            <dd class="col-sm-9">@(Model.IsActive ? "Active" : "Inactive")</dd>
        </dl>
    </div>

    <div>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>