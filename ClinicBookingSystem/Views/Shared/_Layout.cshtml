@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    Func<string, string, string> active = (c, a) => currentController == c && (string.IsNullOrEmpty(a) || currentAction == a) ? "active" : "";
    var userDisplayName = User.Identity?.Name?.Split('@')[0] ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ClinicCare</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ClinicBookingSystem.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <nav class="navbar navbar-expand-lg navbar-toggleable-lg navbar-light">
            <div class="container topbar-wrap">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="logo-mark"><i class="bi bi-heart-pulse-fill"></i></span>
                    <span class="brand-text">
                        <span class="brand-name">Clinic<span>Care</span></span>
                        <span class="brand-tag">Appointment Booking System</span>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 align-items-lg-center gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link text-nowrap @(active("Home", "Index"))" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        @if (!SignInManager.IsSignedIn(User) || User.IsInRole("Patient"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-nowrap @(active("Doctor", "Index"))" asp-area="" asp-controller="Doctor" asp-action="Index">Find a Doctor</a>
                            </li>
                        }

                        @if (SignInManager.IsSignedIn(User) && User.IsInRole("Doctor"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-nowrap @(active("Appointment", "DoctorSchedule"))"
                                   asp-area="" asp-controller="Appointment" asp-action="DoctorSchedule">My Schedule</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-nowrap @(active("AvailabilitySlot", "Create"))"
                                   asp-area="" asp-controller="AvailabilitySlot" asp-action="Create"> Add Slot </a>
                            </li>
                        }

                        @if (SignInManager.IsSignedIn(User) && User.IsInRole("Patient"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-nowrap @(active("Appointment", "PatientAppointments"))" asp-area="" asp-controller="Appointment" asp-action="PatientAppointments">My Appointments</a>
                            </li>
                        }

                        @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-nowrap @(active("User", "Index"))" asp-area="" asp-controller="User" asp-action="Index">Users</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-nowrap @(active("Doctor", "Index"))" asp-area="" asp-controller="Doctor" asp-action="Index">Doctors</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-nowrap @(active("Appointment", "Index"))" asp-area="" asp-controller="Appointment" asp-action="Index">All Appointments</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-nowrap @(active("AvailabilitySlot", "Create"))"
                                   asp-area="" asp-controller="AvailabilitySlot" asp-action="Create">Add Doctor Slot</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-lg-center">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <span class="nav-user nav-link"><i class="bi bi-person-circle"></i> Hello, @userDisplayName!</span>
                            </li>
                            <li class="nav-item">
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-link btn-logout nav-link">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Account" asp-action="Login">Sign In</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link btn-register" asp-area="" asp-controller="Account" asp-action="Register">Create Account</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @* ================= THE BODY =================
       Every view's content renders here, inside @RenderBody().
       Views have no <html>/<body> of their own — e.g. Views/Home/Index.cshtml
       (hero, stats, specialties, how-booking-works, doctors) is injected here. *@
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container topbar-wrap py-5">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="footer-brand mb-2">Clinic<span>Care</span></div>
                    <p class="small mb-0">Clinic Appointment Booking System — book visits, follow up with your doctors.</p>
                </div>
                <div class="col-md-4">
                    <h6>Explore</h6>
                    <ul>
                        <li><a asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-area="" asp-controller="Doctor" asp-action="Index">Find a Doctor</a></li>
                        <li><a asp-area="" asp-controller="Appointment" asp-action="Index">My Appointments</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6>Account</h6>
                    <ul>
                        <li><a asp-area="" asp-controller="Account" asp-action="Login">Sign In</a></li>
                        <li><a asp-area="" asp-controller="Account" asp-action="Register">Create Account</a></li>
                    </ul>
                    <h6 class="mt-4">Built on</h6>
                    <ul>
                        <li>ASP.NET Core MVC</li>
                        <li>Entity Framework Core</li>
                        <li>ASP.NET Identity</li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container topbar-wrap py-3 text-center">
                &copy; 2026 ClinicCare — Clinic Appointment System
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
