@using ClinicBookingSystem.ModelVM.User
@model LoginVM
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — ClinicCare</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        :root {
            --teal: #0d9488;
            --teal-dark: #0f766e;
            --navy: #0f2a43;
            --ink: #1e293b;
            --muted: #64748b;
            --line: #e2e8f0;
            --soft: #f0fdfa;
        }

        * {
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: #f8fafc;
            color: var(--ink);
        }

        .auth-wrap {
            display: flex;
            min-height: 100vh;
        }

        /* ---------- Brand panel ---------- */
        .auth-brand {
            flex: 1 1 46%;
            background: linear-gradient(150deg, #0f766e 0%, #0d9488 45%, #0f2a43 100%);
            color: #fff;
            padding: 3rem 3.5rem;
            display: flex;
            flex-direction: column;
            position: relative;
            overflow: hidden;
        }

            .auth-brand::before,
            .auth-brand::after {
                content: "";
                position: absolute;
                border-radius: 50%;
                border: 1px solid rgba(255, 255, 255, .14);
            }

            .auth-brand::before {
                width: 420px;
                height: 420px;
                top: -140px;
                right: -140px;
            }

            .auth-brand::after {
                width: 300px;
                height: 300px;
                bottom: -110px;
                left: -90px;
            }

        .brand-logo {
            display: flex;
            align-items: center;
            gap: .7rem;
            position: relative;
            z-index: 1;
        }

            .brand-logo .logo-mark {
                width: 52px;
                height: 52px;
                border-radius: 14px;
                background: #fff;
                color: var(--teal-dark);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.7rem;
                box-shadow: 0 10px 25px rgba(0, 0, 0, .18);
            }

            .brand-logo .logo-name {
                font-size: 1.5rem;
                font-weight: 800;
                letter-spacing: .3px;
            }

                .brand-logo .logo-name span {
                    color: #5eead4;
                }

            .brand-logo .logo-tag {
                font-size: .78rem;
                opacity: .85;
                margin-top: -2px;
            }

        .brand-hero {
            margin: auto 0;
            position: relative;
            z-index: 1;
        }

            .brand-hero .eyebrow {
                display: inline-flex;
                align-items: center;
                gap: .45rem;
                background: rgba(255, 255, 255, .14);
                border: 1px solid rgba(255, 255, 255, .22);
                padding: .35rem .9rem;
                border-radius: 100px;
                font-size: .8rem;
                font-weight: 500;
            }

            .brand-hero h1 {
                font-size: 2.5rem;
                font-weight: 800;
                line-height: 1.2;
                margin: 1.3rem 0 .9rem;
            }

                .brand-hero h1 span {
                    color: #5eead4;
                }

            .brand-hero p.lead {
                font-size: 1.02rem;
                opacity: .92;
                line-height: 1.7;
                max-width: 460px;
            }

        .brand-features {
            list-style: none;
            padding: 0;
            margin: 2rem 0 0;
            display: grid;
            gap: .9rem;
        }

            .brand-features li {
                display: flex;
                align-items: center;
                gap: .8rem;
                font-size: .95rem;
            }

            .brand-features .f-ico {
                width: 38px;
                height: 38px;
                flex: 0 0 38px;
                border-radius: 10px;
                background: rgba(255, 255, 255, .14);
                border: 1px solid rgba(255, 255, 255, .2);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.05rem;
            }

        .brand-foot {
            position: relative;
            z-index: 1;
            font-size: .82rem;
            opacity: .8;
        }

        /* ---------- Form panel ---------- */
        .auth-form {
            flex: 1 1 54%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 3rem 2rem;
            background: #fff;
        }

        .form-box {
            width: 100%;
            max-width: 500px;
        }

            .form-box h2 {
                font-size: 1.85rem;
                font-weight: 700;
                color: var(--navy);
                margin-bottom: .35rem;
            }

            .form-box .sub {
                color: var(--muted);
                font-size: .95rem;
                margin-bottom: 1.7rem;
            }

        .form-label {
            font-size: .86rem;
            font-weight: 600;
            color: var(--navy);
            margin-bottom: .35rem;
        }

            .form-label .req {
                color: #dc2626;
            }

        .input-ico {
            position: relative;
        }

            .input-ico > i {
                position: absolute;
                top: 50%;
                transform: translateY(-50%);
                right: 14px;
                color: #94a3b8;
                font-size: 1rem;
                pointer-events: none;
            }

            .input-ico .form-control {
                padding-right: 2.6rem;
            }

        .form-control, .form-select {
            border: 1.5px solid var(--line);
            border-radius: 12px;
            padding: .72rem 1rem;
            font-size: .93rem;
            color: var(--ink);
        }

            .form-control:focus, .form-select:focus {
                border-color: var(--teal);
                box-shadow: 0 0 0 4px rgba(13, 148, 136, .14);
            }

            .form-control.input-validation-error {
                border-color: #dc2626;
            }

        .field-validation-error, .text-danger {
            font-size: .8rem;
        }

        /* Hide the empty validation summary: ASP.NET renders it with
                   .validation-summary-valid when there are no errors, and this
                   standalone view has no site.css to hide it — without this rule
                   the "alert alert-danger" box shows empty above the form. */
        .validation-summary-valid {
            display: none;
        }

        .validation-summary-errors ul {
            margin-bottom: 0;
        }

        .pw-toggle {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            left: 10px;
            border: none;
            background: none;
            color: #94a3b8;
            font-size: 1.05rem;
            cursor: pointer;
            padding: .2rem .4rem;
            z-index: 2;
        }

            .pw-toggle:hover {
                color: var(--teal-dark);
            }

        .has-toggle .form-control {
            padding-left: 2.5rem;
        }

        .btn-submit {
            width: 100%;
            border: none;
            border-radius: 12px;
            padding: .85rem;
            font-size: 1rem;
            font-weight: 600;
            color: #fff;
            background: linear-gradient(120deg, #0d9488, #0f766e);
            box-shadow: 0 10px 22px rgba(13, 148, 136, .32);
            transition: transform .15s, box-shadow .15s;
        }

            .btn-submit:hover {
                transform: translateY(-2px);
                box-shadow: 0 14px 26px rgba(13, 148, 136, .38);
                color: #fff;
            }

        .forgot-link {
            font-size: .88rem;
            color: var(--teal-dark);
            font-weight: 600;
            text-decoration: none;
        }

            .forgot-link:hover {
                text-decoration: underline;
            }

        .login-link {
            text-align: center;
            margin-top: 1.4rem;
            font-size: .92rem;
            color: var(--muted);
        }

            .login-link a {
                color: var(--teal-dark);
                font-weight: 600;
                text-decoration: none;
            }

                .login-link a:hover {
                    text-decoration: underline;
                }

        @@media (max-width: 991px) {
            .auth-wrap {
                flex-direction: column;
            }

            .auth-brand {
                padding: 2.2rem 1.8rem;
            }

            .brand-hero h1 {
                font-size: 1.9rem;
            }

            .brand-features {
                display: none;
            }

            .auth-form {
                padding: 2.2rem 1.2rem;
            }
        }
    </style>
</head>
<body>
    <div class="auth-wrap">

        <!-- Brand panel -->
        <aside class="auth-brand">
            <div class="brand-logo">
                <div class="logo-mark"><i class="bi bi-heart-pulse-fill"></i></div>
                <div>
                    <div class="logo-name">Clinic<span>Care</span></div>
                    <div class="logo-tag">Appointment Booking System</div>
                </div>
            </div>

            <div class="brand-hero">
                <span class="eyebrow"><i class="bi bi-shield-check"></i> Trusted healthcare, simplified</span>
                <h1>Welcome back,<br />your care <span>continues.</span></h1>
                <p class="lead">Sign in to view your upcoming appointments, book new visits, and follow up with your doctors — all in one place.</p>
                <ul class="brand-features">
                    <li><span class="f-ico"><i class="bi bi-calendar-check"></i></span> Your appointments, at a glance</li>
                    <li><span class="f-ico"><i class="bi bi-clock-history"></i></span> Live doctor availability &amp; reminders</li>
                    <li><span class="f-ico"><i class="bi bi-file-medical"></i></span> Your visits &amp; history, always at hand</li>
                </ul>
            </div>

            <div class="brand-foot">© 2026 ClinicCare — Clinic Appointment System</div>
        </aside>

        <!-- Form panel -->
        <main class="auth-form">
            <div class="form-box">
                <h2>Sign in</h2>
                <p class="sub">Enter your Gmail and password to continue.</p>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                <form asp-controller="Account" asp-action="Login" method="post" novalidate>
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Email" class="form-label">Email Address <span class="req">*</span></label>
                            <div class="input-ico">
                                <input asp-for="Email" type="email" class="form-control" placeholder="you@gmail.com" autocomplete="email" />
                                <i class="bi bi-envelope"></i>
                            </div>
                            <span asp-validation-for="Email" class="text-danger"></span>
                            <div class="form-text">A Gmail address is required for this system.</div>
                        </div>

                        <div class="col-12">
                            <label asp-for="Password" class="form-label">Password <span class="req">*</span></label>
                            <div class="input-ico has-toggle">
                                <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                                <button type="button" class="pw-toggle" data-target="Password" aria-label="Show password"><i class="bi bi-eye"></i></button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="col-12 d-flex justify-content-end">
                            <a asp-controller="Account" asp-action="ForgotPassword" class="forgot-link">Forgot password?</a>
                        </div>

                        <div class="col-12 mt-3">
                            <button type="submit" class="btn-submit">
                                Sign In <i class="bi bi-arrow-right ms-1"></i>
                            </button>
                        </div>
                    </div>
                </form>

                <p class="login-link">
                    Don't have an account?
                    <a asp-controller="Account" asp-action="Register">Create one</a>
                </p>
            </div>
        </main>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script>
        // Show / hide password (starts masked)
        document.querySelectorAll('.pw-toggle').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = document.getElementById(btn.getAttribute('data-target'));
                var icon = btn.querySelector('i');
                if (input.type === 'password') {
                    input.type = 'text';
                    icon.classList.remove('bi-eye');
                    icon.classList.add('bi-eye-slash');
                } else {
                    input.type = 'password';
                    icon.classList.remove('bi-eye-slash');
                    icon.classList.add('bi-eye');
                }
            });
        });
    </script>
</body>
</html>
