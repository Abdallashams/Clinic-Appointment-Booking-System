@using ClinicBookingSystem.ModelVM.User
@model RegisterVm
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Account — ClinicCare</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        :root {
            --teal: #0d9488;
            --teal-dark: #0f766e;
            --navy: #0f2a43;
            --ink: #1e293b;
            --muted: #64748b;
            --line: #e2e8f0;
            --soft: #f0fdfa;
        }

        * { font-family: 'Poppins', sans-serif; }

        body { background: #f8fafc; color: var(--ink); }

        .auth-wrap { display: flex; min-height: 100vh; }

        /* ---------- Brand panel ---------- */
        .auth-brand {
            flex: 1 1 46%;
            background: linear-gradient(150deg, #0f766e 0%, #0d9488 45%, #0f2a43 100%);
            color: #fff;
            padding: 3rem 3.5rem;
            display: flex;
            flex-direction: column;
            position: relative;
            overflow: hidden;
        }

        .auth-brand::before,
        .auth-brand::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            border: 1px solid rgba(255, 255, 255, .14);
        }

        .auth-brand::before { width: 420px; height: 420px; top: -140px; right: -140px; }
        .auth-brand::after { width: 300px; height: 300px; bottom: -110px; left: -90px; }

        .brand-logo { display: flex; align-items: center; gap: .7rem; position: relative; z-index: 1; }
        .brand-logo .logo-mark {
            width: 52px; height: 52px; border-radius: 14px;
            background: #fff; color: var(--teal-dark);
            display: flex; align-items: center; justify-content: center;
            font-size: 1.7rem;
            box-shadow: 0 10px 25px rgba(0, 0, 0, .18);
        }
        .brand-logo .logo-name { font-size: 1.5rem; font-weight: 800; letter-spacing: .3px; }
        .brand-logo .logo-name span { color: #5eead4; }
        .brand-logo .logo-tag { font-size: .78rem; opacity: .85; margin-top: -2px; }

        .brand-hero { margin: auto 0; position: relative; z-index: 1; }
        .brand-hero .eyebrow {
            display: inline-flex; align-items: center; gap: .45rem;
            background: rgba(255, 255, 255, .14);
            border: 1px solid rgba(255, 255, 255, .22);
            padding: .35rem .9rem; border-radius: 100px;
            font-size: .8rem; font-weight: 500;
        }
        .brand-hero h1 { font-size: 2.5rem; font-weight: 800; line-height: 1.2; margin: 1.3rem 0 .9rem; }
        .brand-hero h1 span { color: #5eead4; }
        .brand-hero p.lead { font-size: 1.02rem; opacity: .92; line-height: 1.7; max-width: 460px; }

        .brand-features { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; gap: .9rem; }
        .brand-features li { display: flex; align-items: center; gap: .8rem; font-size: .95rem; }
        .brand-features .f-ico {
            width: 38px; height: 38px; flex: 0 0 38px; border-radius: 10px;
            background: rgba(255, 255, 255, .14); border: 1px solid rgba(255, 255, 255, .2);
            display: flex; align-items: center; justify-content: center; font-size: 1.05rem;
        }

        .brand-foot { position: relative; z-index: 1; font-size: .82rem; opacity: .8; }

        /* ---------- Form panel ---------- */
        .auth-form {
            flex: 1 1 54%;
            display: flex; align-items: center; justify-content: center;
            padding: 3rem 2rem;
            background: #fff;
        }

        .form-box { width: 100%; max-width: 500px; }

        .form-box h2 { font-size: 1.85rem; font-weight: 700; color: var(--navy); margin-bottom: .35rem; }
        .form-box .sub { color: var(--muted); font-size: .95rem; margin-bottom: 1.7rem; }

        .form-label { font-size: .86rem; font-weight: 600; color: var(--navy); margin-bottom: .35rem; }
        .form-label .req { color: #dc2626; }

        .input-ico { position: relative; }
        .input-ico > i {
            position: absolute; top: 50%; transform: translateY(-50%);
            right: 14px; color: #94a3b8; font-size: 1rem; pointer-events: none;
        }
        .input-ico .form-control { padding-right: 2.6rem; }

        .form-control, .form-select {
            border: 1.5px solid var(--line); border-radius: 12px;
            padding: .72rem 1rem; font-size: .93rem; color: var(--ink);
        }
        .form-control:focus, .form-select:focus {
            border-color: var(--teal);
            box-shadow: 0 0 0 4px rgba(13, 148, 136, .14);
        }
        .form-control.input-validation-error { border-color: #dc2626; }
        .field-validation-error, .text-danger { font-size: .8rem; }

        .pw-toggle {
            position: absolute; top: 50%; transform: translateY(-50%); left: 10px;
            border: none; background: none; color: #94a3b8; font-size: 1.05rem;
            cursor: pointer; padding: .2rem .4rem; z-index: 2;
        }
        .pw-toggle:hover { color: var(--teal-dark); }
        .has-toggle .form-control { padding-left: 2.5rem; }

        .strength { display: flex; gap: 6px; margin-top: .5rem; }
        .strength span { height: 5px; flex: 1; border-radius: 100px; background: #e2e8f0; transition: background .25s; }
        .strength-label { font-size: .78rem; color: var(--muted); margin-top: .3rem; min-height: 1.1em; }

        .role-pills { display: flex; gap: .6rem; flex-wrap: wrap; }
        .role-pill { margin: 0; }
        .role-pill input { position: absolute; opacity: 0; pointer-events: none; }
        .role-pill .pill {
            display: inline-flex; align-items: center; gap: .45rem;
            border: 1.5px solid var(--line); border-radius: 100px;
            padding: .5rem 1rem; font-size: .88rem; font-weight: 500; color: var(--ink);
            cursor: pointer; transition: all .2s; background: #fff;
        }
        .role-pill .pill i { color: var(--teal); }
        .role-pill input:checked + .pill {
            background: var(--soft); border-color: var(--teal); color: var(--teal-dark);
            box-shadow: 0 0 0 3px rgba(13, 148, 136, .12);
        }

        .btn-submit {
            width: 100%; border: none; border-radius: 12px;
            padding: .85rem; font-size: 1rem; font-weight: 600; color: #fff;
            background: linear-gradient(120deg, #0d9488, #0f766e);
            box-shadow: 0 10px 22px rgba(13, 148, 136, .32);
            transition: transform .15s, box-shadow .15s;
        }
        .btn-submit:hover { transform: translateY(-2px); box-shadow: 0 14px 26px rgba(13, 148, 136, .38); color: #fff; }

        .login-link { text-align: center; margin-top: 1.4rem; font-size: .92rem; color: var(--muted); }
        .login-link a { color: var(--teal-dark); font-weight: 600; text-decoration: none; }
        .login-link a:hover { text-decoration: underline; }

        @@media (max-width: 991px) {
            .auth-wrap { flex-direction: column; }
            .auth-brand { padding: 2.2rem 1.8rem; }
            .brand-hero h1 { font-size: 1.9rem; }
            .brand-features { display: none; }
            .auth-form { padding: 2.2rem 1.2rem; }
        }
    </style>
</head>
<body>
    <div class="auth-wrap">

        <!-- Brand panel -->
        <aside class="auth-brand">
            <div class="brand-logo">
                <div class="logo-mark"><i class="bi bi-heart-pulse-fill"></i></div>
                <div>
                    <div class="logo-name">Clinic<span>Care</span></div>
                    <div class="logo-tag">Appointment Booking System</div>
                </div>
            </div>

            <div class="brand-hero">
                <span class="eyebrow"><i class="bi bi-shield-check"></i> Trusted healthcare, simplified</span>
                <h1>Your health,<br />one appointment <span>away.</span></h1>
                <p class="lead">Create your account to book visits, follow up with your doctors, and manage all your appointments in one place.</p>
                <ul class="brand-features">
                    <li><span class="f-ico"><i class="bi bi-calendar-check"></i></span> Book appointments in under a minute</li>
                    <li><span class="f-ico"><i class="bi bi-clock-history"></i></span> Live doctor availability &amp; reminders</li>
                    <li><span class="f-ico"><i class="bi bi-file-medical"></i></span> Your visits &amp; history, always at hand</li>
                </ul>
            </div>

            <div class="brand-foot">© 2026 ClinicCare — Clinic Appointment System</div>
        </aside>

        <!-- Form panel -->
        <main class="auth-form">
            <div class="form-box">
                <h2>Create your account</h2>
                <p class="sub">Join ClinicCare and start booking in seconds.</p>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                <form asp-controller="Account" asp-action="Register" method="post" novalidate>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="IsActive" />

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="FullName" class="form-label">Full Name <span class="req">*</span></label>
                            <div class="input-ico">
                                <input asp-for="FullName" class="form-control" placeholder="e.g. Ahmed Mohamed" autocomplete="name" />
                                <i class="bi bi-person"></i>
                            </div>
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="UserName" class="form-label">Username <span class="req">*</span></label>
                            <div class="input-ico">
                                <input asp-for="UserName" class="form-control" placeholder="ahmed.m" autocomplete="username" />
                                <i class="bi bi-at"></i>
                            </div>
                            <span asp-validation-for="UserName" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label">Phone Number <span class="req">*</span></label>
                            <div class="input-ico">
                                <input asp-for="PhoneNumber" class="form-control" placeholder="+20 100 000 0000" autocomplete="tel" />
                                <i class="bi bi-telephone"></i>
                            </div>
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Email" class="form-label">Email Address <span class="req">*</span></label>
                            <div class="input-ico">
                                <input asp-for="Email" class="form-control" placeholder="you@gmail.com" autocomplete="email" />
                                <i class="bi bi-envelope"></i>
                            </div>
                            <span asp-validation-for="Email" class="text-danger"></span>
                            <div class="form-text">A Gmail address is required for this system.</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label">Password <span class="req">*</span></label>
                            <div class="input-ico has-toggle">
                                <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="new-password" />
                                <button type="button" class="pw-toggle" data-target="Password" aria-label="Show password"><i class="bi bi-eye"></i></button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger"></span>
                            <div class="strength" id="strengthBar"><span></span><span></span><span></span><span></span></div>
                            <div class="strength-label" id="strengthLabel"></div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label">Confirm Password <span class="req">*</span></label>
                            <div class="input-ico has-toggle">
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" autocomplete="new-password" />
                                <button type="button" class="pw-toggle" data-target="ConfirmPassword" aria-label="Show password"><i class="bi bi-eye"></i></button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Register as</label>
                            <div class="role-pills">
                                <label class="role-pill">
                                    <input type="checkbox" name="Roles" value="Patient" checked />
                                    <span class="pill"><i class="bi bi-person-heart"></i> Patient</span>
                                </label>
                            </div>
                            <span asp-validation-for="Roles" class="text-danger"></span>
                        </div>

                        <div class="col-12 mt-4">
                            <button type="submit" class="btn-submit">
                                Create Account <i class="bi bi-arrow-right ms-1"></i>
                            </button>
                        </div>
                    </div>
                </form>

                <p class="login-link">
                    Already have an account?
                    <a asp-controller="Account" asp-action="Login">Sign in</a>
                </p>
            </div>
        </main>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script>
        // Show / hide password
        document.querySelectorAll('.pw-toggle').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = document.getElementById(btn.getAttribute('data-target'));
                var icon = btn.querySelector('i');
                if (input.type === 'password') {
                    input.type = 'text';
                    icon.classList.remove('bi-eye');
                    icon.classList.add('bi-eye-slash');
                } else {
                    input.type = 'password';
                    icon.classList.remove('bi-eye-slash');
                    icon.classList.add('bi-eye');
                }
            });
        });

        // Password strength meter
        (function () {
            var pw = document.getElementById('Password');
            var bar = document.getElementById('strengthBar');
            var label = document.getElementById('strengthLabel');
            if (!pw || !bar) return;
            var colors = ['', '#dc2626', '#f59e0b', '#84cc16', '#0d9488'];
            var texts = ['', 'Weak', 'Fair', 'Good', 'Strong'];
            pw.addEventListener('input', function () {
                var v = pw.value, score = 0;
                if (v.length >= 8) score++;
                if (/[A-Z]/.test(v) && /[a-z]/.test(v)) score++;
                if (/\d/.test(v)) score++;
                if (/[^A-Za-z0-9]/.test(v)) score++;
                var segs = bar.querySelectorAll('span');
                segs.forEach(function (s, i) {
                    s.style.background = i < score ? colors[score] : '#e2e8f0';
                });
                label.textContent = v ? texts[score] : '';
                label.style.color = colors[score] || '';
            });
        })();
    </script>
</body>
</html>
